  "heading": "\\integer.pair.mul",
  "heading_latex": "\\textrm{integer-pair multiplication}\\quad\\htmlClass{mlg-title-written}{a \\cdot_{\\mathbb{Z}} b}",
  "body_text": null,
  "page": null,
  "source": "[\\integer.pair.mul]\nDefines: mul(a_, b_) is \\binary.operation:on{\\integer.pair.carrier}\nexpresses:\n. forAll: a1, b1, a2, b2 is \\natural\n  then:\n  . let: ac, bd, ad, bc is \\natural\n    where:\n    . ac = a1 \\.natural.*./ a2\n    . bd = b1 \\.natural.*./ b2\n    . ad = a1 \\.natural.*./ b2\n    . bc = b1 \\.natural.*./ a2\n    then: mul(\\integer.pair.class:of{a1, b1}, \\integer.pair.class:of{a2, b2}) = \\integer.pair.class:of{ac \\.natural.+./ bd, ad \\.natural.+./ bc}\nDocumented:\n. called: \"integer-pair multiplication\"\n. written: \"a_? \\cdot_{\\mathbb{Z}} b_?\"\n. description: \"Multiplication induced by the identity\n                $(a-b)(c-d)=(ac+bd)-(ad+bc)$.\"\nId: \"851822e5-633e-477d-aaa9-175898ceb06e\"",
