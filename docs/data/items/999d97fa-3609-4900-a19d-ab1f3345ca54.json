  "source": "[\\ideal:of{R ::= (X, +, *, 0, 1)}]\nDeclares: I \\:subset:/ X\nwhen: R is \\ring\nsatisfies:\n. 0 \"in\" I\n. forAll: x, y \"in\" I\n  then: x + y \"in\" I\n. forAll: x \"in\" I\n  then:\n  . exists: y \"in\" I\n    suchThat: x + y = 0\n. forAll: r \"in\" R\n  then:\n  . forAll: i \"in\" I\n    then:\n    . r * i \"in\" I\n    . i * r \"in\" I\nDocumented:\n. called: \"ideal of $R?$\"\n. description: \"An ideal is an additive subgroup closed under multiplication by\n                arbitrary ring elements.\"\nId: \"999d97fa-3609-4900-a19d-ab1f3345ca54\"",
