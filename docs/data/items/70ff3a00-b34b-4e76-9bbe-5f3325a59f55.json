  "source": "[\\function.image:of{f(x__)}:on{X}]\nDefines: Y is \\set\nwhen:\n. f is \\function:on{A?}:to{B?}\n. X \\:subset:/ A\nexpresses:\n. let: y is \\set\n  then:\n  . have: y \"in\"? Y\n    iff:\n    . exists: x \"in\" X\n      suchThat: f(x) = y\nDocumented:\n. called: \"image of $X?$ under $f?$\"\n. written: \"f?[X?]\"\n. description: \"The direct image $f[X]$ is the set of all outputs obtained by\n                evaluating $f$ on elements of $X$.\"\nId: \"70ff3a00-b34b-4e76-9bbe-5f3325a59f55\"",
