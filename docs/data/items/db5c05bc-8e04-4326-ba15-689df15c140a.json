  ],
  "body_text": null,
  "page": null,
  "source": "[\\center:of{G ::= (X, *, e)}]\nDefines: Z is \\set\nwhen: G is \\group\nexpresses:\n. let: z is \\set\n  then:\n  . have: z \"in\"? Z\n    iff:\n    . z \"in\"? G\n    . forAll: g \"in\" G\n      then: z * g = g * z\nDocumented:\n. called: \"center of group $G?$\"\n. written: \"Z(G?)\"\n. description: \"The center $Z(G)$ is the subgroup of elements that commute with\n                all elements of $G$.\"\nId: \"db5c05bc-8e04-4326-ba15-689df15c140a\"",
