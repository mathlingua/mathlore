  "source": "[\\real.cauchy.realization]\nRealizes: Rb ::= (R, 0, 1, +, *, neg(x_), inv(x_), leq(a_, b_)) := \\reals\nspecifies:\n. R := \\real.cauchy.carrier\n. 0 := \\real.cauchy.zero\n. 1 := \\real.cauchy.one\n. + := \\real.cauchy.add\n. * := \\real.cauchy.mul\n. neg := \\real.cauchy.neg\n. inv := \\real.cauchy.inv\n. leq := \\real.cauchy.leq\nEnables:\n. capability: x_ \"in\" Rb :<->: x_ \"in\" R\nDocumented:\n. called: \"reals as Cauchy sequences\"\n. description: \"The concrete realization of the abstract real tuple as\n                equivalence classes of rational Cauchy sequences, with every\n                field operation induced from sequence operations.\"\nId: \"b03848a9-e6b1-4bca-8436-8dd755e5a026\"",
