  "heading": "\\integer.pair.leq",
  "heading_latex": "\\textrm{integer-pair order}\\quad\\htmlClass{mlg-title-written}{a \\leq_{\\mathbb{Z}} b}",
  "body_text": null,
  "page": null,
  "source": "[\\integer.pair.leq]\nDefines: leq(a_, b_) is \\total.order:on{\\integer.pair.carrier}\nexpresses:\n. forAll: a1, b1, a2, b2 is \\natural\n  then:\n  . let: lhs, rhs is \\natural\n    where:\n    . lhs = a1 \\.natural.+./ b2\n    . rhs = a2 \\.natural.+./ b1\n    then:\n    . have: leq(\\integer.pair.class:of{a1, b1}, \\integer.pair.class:of{a2, b2})\n      iff: lhs \\:natural.leq?:/ rhs\nDocumented:\n. called: \"integer-pair order\"\n. written: \"a_? \\leq_{\\mathbb{Z}} b_?\"\n. description: \"The quotient order $[(a,b)] \\le [(c,d)]$ exactly when\n                $a+d \\le c+b$.\"\nId: \"58e8d2d9-b0e3-416b-8536-3fb3a8b9063a\"",
