Title: "The Complex Field"
Id: "8eb34ec3-71e1-4565-b43c-b53ca58ab01f"


Text: "The complex numbers $\mathbb{C}$ extend the real numbers by adjoining the
       imaginary unit $i$ satisfying $i^2 = -1$. The resulting field is
       algebraically closed and possesses rich planar geometry."
Id: "984eae6c-91ed-4fb5-8837-8169f4a2c022"


SectionTitle: "The Field of Complex Numbers"
Id: "4da5affd-d43d-45a1-a71a-4cd60b320278"


[\complex.numbers]
Defines: Cb ::= (C, 0, 1, +, *, -, /, i, neg(z_))
abstractly:
specifies:
. C is \set
. 0 "in" C
. 1 "in" C
. i "in" C
. + is \binary.operation:on{C}
. * is \binary.operation:on{C}
. - is \binary.operation:on{C}
. / is \binary.operation:on{C}
. neg is \function:on{C}:to{C}
expresses:
. 0 != 1
. i * i = -1
. forAll: a, b, c "in" C
  then:
  . (a + b) + c = a + (b + c)
  . a + b = b + a
  . a + 0 = a
  . (a * b) * c = a * (b * c)
  . a * b = b * a
  . a * 1 = a
  . a * (b + c) = (a * b) + (a * c)
Enables:
. capability: z_ "in" Cb :-> z_ is \complex
. view:
  as: S := C is \set
Documented:
. called: "the complex numbers"
. written: "\mathbb{C}"
. description: "The field of complex numbers
                $\mathbb{C} = \mathbb{R}[i] / (i^2 + 1)$."
Id: "19cb593a-f9c4-4ac8-82b7-2f32e590b67a"


[\complex]
Declares: z "in" \complex.numbers..C
Enables:
. capability: a_ + b_ :=> a_ \.complex.+./ b_
. capability: a_ - b_ :=> a_ \.complex.-./ b_
. capability: a_ * b_ :=> a_ \.complex.*./ b_
. capability: a_ / b_ :=> a_ \.complex.div./ b_
. capability: -a_ :=> \complex.neg(a_)
Documented:
. called: "complex"
. description: "A complex number is an element of $\mathbb{C}$."
Id: "af678a67-39ff-4563-a687-c4019d154b5a"


[\complex.zero]
Defines: z := \complex.numbers..0 is \complex
Documented:
. called: "complex zero"
. written: "0"
Id: "f278c550-28e5-44ec-93d2-4842994848fb"


[\complex.one]
Defines: o := \complex.numbers..1 is \complex
Documented:
. called: "complex one"
. written: "1"
Id: "09630bb3-b7f2-4eb9-b9c7-b0ccb59b191f"


[a_ \.complex.+./ b_]
Defines: a_ + b_ := \complex.numbers..`+`(a_, b_) is \complex
Documented:
. called: "$a_?$ plus $b_?$"
. written: "a_? + b_?"
Id: "10bb451f-8177-4d04-81a7-2ac67de483d0"


[a_ \.complex.-./ b_]
Defines: a_ - b_ := \complex.numbers..`-`(a_, b_) is \complex
Documented:
. called: "$a_?$ minus $b_?$"
. written: "a_? - b_?"
Id: "6fd7f728-8217-40bf-9d81-750e40ea2b6e"


[a_ \.complex.*./ b_]
Defines: a_ * b_ := \complex.numbers..`*`(a_, b_) is \complex
Documented:
. called: "$a_?$ times $b_?$"
. written: "a_? \cdot b_?"
Id: "27f9f3f8-5272-4083-9fa0-e7a4948a4362"


[a_ \.complex.div./ b_]
Defines: a_ / b_ := \complex.numbers..`/`(a_, b_) is \complex
Documented:
. called: "$a_?$ divided by $b_?$"
. written: "\frac{a_?}{b_?}"
Id: "16fc3b48-1abc-4a63-b4d4-b4c5c144b20b"


[\complex.neg(a_)]
Defines: n := \complex.numbers..neg(a_) is \complex
Documented:
. called: "negative of $a_?$"
. written: "-a_?"
Id: "c849f3cc-4b38-40ae-8f55-aa9168f00682"


[\complex.i]
Defines: unit := \complex.numbers..i is \complex
Documented:
. called: "imaginary unit"
. written: "i"
. description: "The imaginary unit $i$ satisfying $i^2 = -1$."
Id: "b5855839-892d-4a4b-a116-7a66ef02df5d"


SectionTitle: "Real Part, Imaginary Part, and Conjugation"
Id: "e5125a7d-d915-4ca8-a6ce-6c928e275445"


[\complex.real.part(z_)]
Defines: x is \real
expresses:
. exists: y is \real
  suchThat: z_ = x \.complex.+./ (y \.complex.*./ \complex.i)
Documented:
. called: "real part of $z_?$"
. written: "\operatorname{Re}(z_?)"
. description: "The real component $\operatorname{Re}(z)$ of a complex number."
Id: "ac392c5f-3f42-42d6-8313-5e4cbd764f89"


[\complex.imaginary.part(z_)]
Defines: y is \real
expresses:
. exists: x is \real
  suchThat: z_ = x \.complex.+./ (y \.complex.*./ \complex.i)
Documented:
. called: "imaginary part of $z_?$"
. written: "\operatorname{Im}(z_?)"
. description: "The imaginary component $\operatorname{Im}(z)$ of a complex
                number."
Id: "962d90fc-e3db-40b5-8c43-91c21277ac0a"


[\complex.conjugate(z_)]
Defines: zbar is \complex
expresses: zbar = \complex.real.part(z_) \.complex.-./ (\complex.imaginary.part(z_) \.complex.*./ \complex.i)
Documented:
. called: "complex conjugate of $z_?$"
. written: "\overline{z_?}"
. description: "The complex conjugate
                $\overline{z} = \operatorname{Re}(z) - i \operatorname{Im}(z)$."
Id: "45f1544a-4db7-477a-8d89-b42698988732"


[\complex.modulus(z_)]
Defines: r is \real
expresses:
. r \:real.geq?:/ \real.zero
. (r \.real.*./ r) = (\complex.real.part(z_) \.real.*./ \complex.real.part(z_)) \.real.+./ (\complex.imaginary.part(z_) \.real.*./ \complex.imaginary.part(z_))
Documented:
. called: "modulus of $z_?$"
. written: "\left| z_? \right|"
. description: "The modulus (absolute value)
                $|z| = \sqrt{\operatorname{Re}(z)^2 + \operatorname{Im}(z)^2}$."
Id: "e5faf733-3580-4323-921a-0809252cada9"
